rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // a child's device linked by the parent (claims set only by the server; revoked by deleting kidDevices/{device})
    function isKid(uid, pid) { return signedIn() && request.auth.token.get('kidOf', '') == uid && request.auth.token.get('kidPid', '') == pid
      && exists(/databases/$(database)/documents/users/$(uid)/kidDevices/$(request.auth.uid)); }

    // users/{uid}: the person's own account. Role is chosen once (parent may become teacher).
    // phoneVerified (and the verified phone) are written only by the server (verifyOtp).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.get('phoneVerified', false) == false
        && request.resource.data.role in ['student', 'parent', 'teacher']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isOwner(uid)
        && (request.resource.data.role == resource.data.role
            || (resource.data.role == 'parent' && request.resource.data.role == 'teacher'))
        && request.resource.data.get('phoneVerified', false) == resource.data.get('phoneVerified', false)
        && (resource.data.get('phoneVerified', false) == false || request.resource.data.get('phone', null) == resource.data.get('phone', null))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if false;

      // children / own profile
      match /profiles/{pid} {
        allow read: if isOwner(uid) || isKid(uid, pid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        // the child may update only his own stats
        allow update: if isKid(uid, pid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']);

        // stars per lesson
        match /progress/{lessonId} {
          allow read: if isOwner(uid) || isKid(uid, pid);
          allow delete: if isOwner(uid);
          allow create, update: if (isOwner(uid) || isKid(uid, pid)) && request.resource.data.done is list && request.resource.data.done.size() <= 20;
        }
      }

      // children's linked devices: written only by the server
      match /kidDevices/{d} { allow read: if isOwner(uid); allow write: if false; }
    }

    // plans: everyone can read prices; only the server (Admin SDK) writes.
    match /plans/{id} { allow read: if true; allow write: if false; }

    // money: written only by Cloud Functions; the owner can read their own.
    // public switches set from the admin panel (open/close grades, subjects, lessons)
    match /config/access { allow read: if true; allow write: if false; }
    match /subscriptions/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.uid == request.auth.token.get('kidOf', '-')); allow write: if false; }
    match /orders/{id}        { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
