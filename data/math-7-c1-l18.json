     "examples": [
      {
       "q": "حلّل العدد 84 إلى عوامله الأولية",
       "steps": [
        "84 ÷ 2 = 42",
        "42 ÷ 2 = 21",
        "21 ÷ 3 = 7",
        "7 ÷ 7 = 1",
        "84 = 2 × 2 × 3 × 7"
       ]
      },
      {
       "q": "حلّل العدد 90 إلى عوامله الأولية",
       "steps": [
        "90 ÷ 2 = 45",
        "45 ÷ 3 = 15",
        "15 ÷ 3 = 5",
        "5 ÷ 5 = 1",
        "90 = 2 × 3 × 3 × 5"
       ]
      }
     ]
    }
