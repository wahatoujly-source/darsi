     "star": true,
     "examples": [
      {
       "q": "نق = 14 سم، θ = 180°. طول القوس؟",
       "steps": [
        "المحيط = 2 × 22/7 × 14 = 88",
        "النسبة = 180 ÷ 360 = 1/2",
        "طول القوس = 44 سم"
       ]
      },
      {
       "q": "نق = 7، θ = 60°",
