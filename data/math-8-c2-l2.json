     "type": "steps",
     "star": true,
     "examples": [
      {
       "q": "اختصر: 24 : 36",
       "steps": [
        "ع.م.أ للعددين 24 و 36 هو 12.",
        "24 ÷ 12 = 2، و 36 ÷ 12 = 3",
        "24 : 36 = 2 : 3"
       ]
      },
      {
       "q": "اختصر: 0.5 : 2",
       "steps": [
        "نضرب الحدّين في 10: 5 : 20",
        "نقسم على 5: 1 : 4"
       ]
      }
     ]
    }
