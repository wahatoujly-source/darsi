=\"242\" cy=\"78\" r=\"4\" fill=\"#c0392b\"/><text x=\"242\" y=\"94\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">بنغازي</text><circle cx=\"128\" cy=\"180\" r=\"4\" fill=\"#c0392b\"/><text x=\"128\" y=\"196\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">سبها</text><circle cx=\"306\" cy=\"236\" r=\"4\" fill=\"#c0392b\"/><text x=\"306\" y=\"252\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">الكفرة</text><path d=\"M160,90 C150,170 170,230 200,300\" stroke=\"#8d5524\" stroke-width=\"3\" stroke-dasharray=\"7 6\" fill=\"none\"/><g><text font-size=\"22\">🐪<animateMotion dur=\"7s\" begin=\"0.0s\" repeatCount=\"indefinite\" path=\"M160,90 C150,170 170,230 200,300\"/></text></g><g><text font-size=\"22\">🐪<animateMotion dur=\"7s\" begin=\"0.9s\" repeatCount=\"indefinite\" path=\"M160,90 C150,170 170,230 200,300\"/></text></g><g><text font-size=\"22\">🐪<animateMotion dur=\"7s\" begin=\"1.8s\" repeatCount=\"indefinite\" path=\"M160,90 C150,170 170,230 200,300\"/></text></g><g><text font-size=\"22\">🐪<animateMotion dur=\"7s\" begin=\"2.7s\" repeatCount=\"indefinite\" path=\"M160,90 C150,170 170,230 200,300\"/></text></g><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">طرق القوافل من الساحل</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">إلى الجنوب</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["النقل البري أهم وسائل النقل في ليبيا، ويشمل الطرق المعبدة والسكك الحديدية.", "الطريق الساحلي: يمتد من رأس اجدير على الحدود التونسية غرباً إلى امساعد على الحدود المصرية شرقاً، بطول نحو 1800 كم، ويربط المدن الساحلية الكبرى.", "الطرق الصحراوية: تربط الشمال بالجنوب، مثل طريق طرابلس — سبها، وطريق أجدابيا — الكفرة، وتربط ليبيا بدول الجوار الجنوبية (النيجر وتشاد).", "قديماً كانت طرق القوافل تنطلق من الساحل إلى الجنوب حتى بلاد السودان (أفريقيا جنوب الصحراء) محملة بالبضائع.", "السكك الحديدية: كانت قليلة وأُوقفت، وهناك مشروعات لإنشاء شبكة حديثة.", "أهمية النقل البري: نقل الركاب والبضائع، وربط المدن والقرى، وتشجيع التجارة والسياحة."]}], "lead": "اقرأ واستمع، وتأمّل الخريطة."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "يبدأ الطريق الساحلي غرباً من:", "a": "رأس اجدير", "o": ["رأس اجدير", "سبها"]}, {"q": "ينتهي الطريق الساحلي شرقاً عند:", "a": "امساعد", "o": ["امساعد", "غات"]}, {"q": "طريق صحراوي يربط الشمال بالجنوب:", "a": "طرابلس — سبها", "o": ["طرابلس — سبها", "طرابلس — الزاوية"]}, {"q": "قديماً كانت البضائع تُنقل بـ:", "a": "القوافل", "o": ["القوافل", "القطارات السريعة"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "الطريق الساحلي", "meaning": "رأس اجدير ← امساعد، نحو 1800 كم", "ex": ""}, {"must": 1, "term": "الطرق الصحراوية", "meaning": "تربط الشمال بالجنوب", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "النقل البري أهم وسائل النقل في ليبيا.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "دولة جنوبية مجاورة:", "a": "النيجر", "o": ["النيجر", "مالطا"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}