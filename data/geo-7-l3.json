\"281\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/><line class=\"dr\" style=\"animation-delay:0.34s\" x1=\"292\" y1=\"86\" x2=\"289\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/><line class=\"dr\" style=\"animation-delay:0.51s\" x1=\"300\" y1=\"86\" x2=\"297\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/><line class=\"dr\" style=\"animation-delay:0.68s\" x1=\"308\" y1=\"86\" x2=\"305\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/><line class=\"dr\" style=\"animation-delay:0.85s\" x1=\"316\" y1=\"86\" x2=\"313\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/><line class=\"dr\" style=\"animation-delay:1.02s\" x1=\"324\" y1=\"86\" x2=\"321\" y2=\"96\" stroke=\"#1e88e5\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الأمطار تتركز على الشريط</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الساحلي والجبل الأخضر</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["المناخ هو متوسط حالة الطقس في مكان خلال فترة زمنية طويلة، من حيث درجات الحرارة والضغط الجوي والرياح والرطوبة والتساقط.", {"h": "العوامل المؤثرة في مناخ ليبيا"}, "الموقع بالنسبة لدوائر العرض، فوسط ليبيا وجنوبها في العروض المدارية الحارة، وشمالها في العروض شبه المعتدلة.", "والقرب من البحر المتوسط الذي يساعد على اعتدال المناخ في الشمال.", "والارتفاع، فالجبل الأخضر والجبل الغربي يزيدان كمية الأمطار.", {"h": "عناصر المناخ"}, "درجة الحرارة: تقل كلما اتجهنا من الجنوب إلى الشمال، وترتفع إلى أقصاها في الصيف، ويلطّفها نسيم البحر في المناطق الساحلية.", "الضغط الجوي: هو وزن عمود الهواء فوق مستوى سطح البحر، وتتحرك الرياح من مناطق الضغط المرتفع إلى مناطق الضغط المنخفض.", "الرياح المحلية: تتعرض ليبيا لرياح القبلي، وهي رياح جنوبية صحراوية محملة بالأتربة، تهب في أواخر الربيع وأوائل الصيف.", "الرطوبة: هي نسبة بخار الماء في الجو، وتقل كلما اتجهنا جنوباً.", "الأمطار: تسقط في الشتاء بسبب الرياح الشمالية الغربية العكسية، وأغزر المناطق أمطاراً الجبل الأخضر الذي يتجاوز معدله خمسمائة وخمسين ملم، أما الصحراء فلا يتجاوز معدلها خمسين ملم."]}], "lead": "استمع إلى الدرس وتابع الجمل المضيئة، أو اضغط على أي جملة لتسمعها."}, {"title": "عناصر", "eyebrow": "الخطوة ٢ — عناصر", "heading": "عنصر المناخ", "blocks": [{"type": "choice", "star": true, "items": [{"q": "نسبة بخار الماء في الجو:", "a": "الرطوبة", "o": ["الرطوبة", "الضغط الجوي", "الحرارة"]}, {"q": "وزن عمود الهواء فوق سطح البحر:", "a": "الضغط الجوي", "o": ["الضغط الجوي", "الرياح", "الرطوبة"]}, {"q": "رياح جنوبية صحراوية محملة بالأتربة:", "a": "القبلي", "o": ["القبلي", "الرياح الشمالية الغربية"]}, {"q": "تتحرك الرياح من الضغط … إلى الضغط …", "a": "المرتفع إلى المنخفض", "o": ["المرتفع إلى المنخفض", "المنخفض إلى المرتفع"]}]}]}, {"title": "صح أم خطأ", "eyebrow": "الخطوة ٣ — صح أم خطأ", "heading": "صح أم خطأ؟", "blocks": [{"type": "choice", "star": true, "items": [{"q": "تقل درجة الحرارة كلما اتجهنا من الجنوب إلى الشمال.", "a": "صح", "o": ["صح", "خطأ"]}, {"q": "الأمطار في ليبيا تسقط صيفاً.", "a": "خطأ", "o": ["صح", "خطأ"], "why": "تسقط شتاءً."}, {"q": "الجبل الأخضر أغزر مناطق ليبيا أمطاراً.", "a": "صح", "o": ["صح", "خطأ"]}, {"q": "رياح القبلي تهب في الشتاء.", "a": "خطأ", "o": ["صح", "خطأ"], "why": "تهب في أواخر الربيع وأوائل الصيف."}], "keep": true}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "المناخ", "meaning": "متوسط حالة الطقس في مكان خلال فترة طويلة", "ex": ""}, {"must": 1, "term": "رياح القبلي", "meaning": "رياح جنوبية صحراوية محملة بالأتربة، تهب أواخر الربيع وأوائل الصيف", "ex": ""}, {"must": 1, "term": "الضغط الجوي", "meaning": "وزن عمود الهواء فوق سطح البحر، ويساوي 76 سم زئبق أو 1013 مليبار", "ex": ""}, {"must": 1, "term": "الأمطار", "meaning": "تسقط شتاءً، وأغزرها في الجبل الأخضر (أكثر من 550 ملم)", "ex": ""}, {"must": 0, "term": "الرطوبة", "meaning": "نسبة بخار الماء في الجو، وتقل جنوباً", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 4, "items": [{"q": "تسقط الأمطار في ليبيا في فصل:", "a": "الشتاء", "o": ["الشتاء", "الصيف"], "ar": true, "why": ""}, {"q": "رياح القبلي رياح:", "a": "جنوبية صحراوية", "o": ["جنوبية صحراوية", "شمالية بحرية"], "ar": true, "why": ""}, {"q": "أغزر مناطق ليبيا أمطاراً:", "a": "الجبل الأخضر", "o": ["الجبل الأخضر", "سبها", "الكفرة"], "ar": true, "why": ""}, {"type": "input", "q": "معدل الأمطار في الصحراء لا يتجاوز كم ملم؟", "a": 50, "why": ""}, {"q": "يلطّف درجة الحرارة في المناطق الساحلية:", "a": "نسيم البحر", "o": ["نسيم البحر", "رياح القبلي"], "ar": true, "why": ""}, {"q": "تتحرك الرياح نحو مناطق الضغط:", "a": "المنخفض", "o": ["المنخفض", "المرتفع"], "ar": true, "why": ""}]}], "lead": "6 أسئلة. تنجح بـ 4 من 6."}]}