       "q": "احسب: (2س/3) × (9/س²)",
       "steps": [
        "نضرب البسطين: 18س، والمقامين: 3س²",
        "18س/3س² = 6/س"
       ]
      },
      {
       "q": "احسب: (4س/5) ÷ (2س/15)",
       "steps": [
        "نقلب الكسر الثاني: 15/2س",
        "(4س/5) × (15/2س) = 60س/10س",
        "= 6"
