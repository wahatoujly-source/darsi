       "q": "بسّط: 6س²/9س",
       "steps": [
        "العامل المشترك للبسط والمقام 3س.",
        "6س² ÷ 3س = 2س، و 9س ÷ 3س = 3",
        "الناتج: 2س/3"
       ]
      },
      {
       "q": "بسّط: (3س − 6)/(س − 2)",
       "steps": [
        "نحلل البسط: 3(س − 2)",
        "نختصر (س − 2) من البسط والمقام.",
        "الناتج: 3"
       ]
      }
     ]
    }
