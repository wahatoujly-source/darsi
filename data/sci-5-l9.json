cle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"1.5s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"2.0s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"2.5s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"3.0s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"3.5s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"4.0s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><circle r=\"5\" fill=\"#1e88e5\"><animateMotion dur=\"5s\" begin=\"4.5s\" repeatCount=\"indefinite\" path=\"M70,90 L310,90 L310,260 L70,260 Z\"/></circle><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">دائرة كهربائية مغلقة: يسري</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">التيار فيضيء المصباح</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["الدائرة الكهربائية: مسار مغلق يسري فيه التيار الكهربائي. وتتكون من: مصدر (بطارية)، وأسلاك توصيل، ومفتاح، وجهاز يستهلك الكهرباء (مصباح أو جرس أو محرك).", "الدائرة المغلقة: يكتمل المسار فيضيء المصباح. والدائرة المفتوحة: المسار مقطوع فلا يسري التيار.", "المفتاح: يفتح الدائرة ويغلقها للتحكم في الجهاز.", "رموز الدائرة: نرسم الدوائر برموز بسيطة: خط طويل وقصير للبطارية، ودائرة فيها × للمصباح، وخطوط مستقيمة للأسلاك.", "زيادة عدد البطاريات تزيد إضاءة المصباح، وزيادة عدد المصابيح على التوالي تقلل إضاءتها.", "الأمان: لا نلعب أبداً بكهرباء المنزل، ولا نلمس الأجهزة بأيدٍ مبللة، ونستخدم البطاريات الصغيرة فقط في التجارب."]}], "lead": "اقرأ واستمع، ثم أجب عن الأسئلة."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "مصدر الكهرباء في الدائرة:", "a": "البطارية", "o": ["البطارية", "المصباح"]}, {"q": "يضيء المصباح عندما تكون الدائرة:", "a": "مغلقة", "o": ["مغلقة", "مفتوحة"]}, {"q": "يتحكم في تشغيل الدائرة:", "a": "المفتاح", "o": ["المفتاح", "السلك"]}, {"q": "زيادة البطاريات تجعل المصباح:", "a": "أكثر إضاءة", "o": ["أكثر إضاءة", "أقل إضاءة"]}]}]}, {"title": "صواب أم خطأ", "eyebrow": "الخطوة ٣ — صواب أم خطأ", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "نلمس الأجهزة الكهربائية بأيدٍ مبللة.", "a": "خطأ", "o": ["صح", "خطأ"]}, {"q": "الدائرة المفتوحة لا يسري فيها التيار.", "a": "صح", "o": ["صح", "خطأ"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "الدائرة المغلقة", "meaning": "يسري التيار", "ex": ""}, {"must": 1, "term": "الدائرة المفتوحة", "meaning": "لا يسري التيار", "ex": ""}, {"must": 1, "term": "الأمان", "meaning": "لا نلعب بكهرباء المنزل", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 1, "items": [{"q": "المفتاح يفتح الدائرة ويغلقها.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}]}], "lead": "1 أسئلة. تنجح بـ 1 من 1."}]}