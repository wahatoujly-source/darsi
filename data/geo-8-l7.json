s=\"sd\" style=\"animation-delay:1.43s\" cx=\"147\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.56s\" cx=\"184\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.69s\" cx=\"221\" cy=\"330\" r=\"3\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.82s\" cx=\"258\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.95s\" cx=\"295\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.08s\" cx=\"332\" cy=\"330\" r=\"3\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.21s\" cx=\"69\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.34s\" cx=\"106\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.47s\" cx=\"143\" cy=\"330\" r=\"3\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.60s\" cx=\"180\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.73s\" cx=\"217\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.86s\" cx=\"254\" cy=\"330\" r=\"3\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:0.99s\" cx=\"291\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.12s\" cx=\"328\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.25s\" cx=\"65\" cy=\"330\" r=\"3\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.38s\" cx=\"102\" cy=\"330\" r=\"4\" fill=\"#c98b35\"/><circle class=\"sd\" style=\"animation-delay:1.51s\" cx=\"139\" cy=\"330\" r=\"2\" fill=\"#c98b35\"/><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">رياح القبلي الحارة المحمّلة</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">بالغبار تهبّ من الجنوب</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["الضغط الجوي: وزن عمود الهواء على وحدة المساحة، ويقاس بالبارومتر. يقل الضغط حيث ترتفع الحرارة (ضغط منخفض)، ويزيد حيث تنخفض (ضغط مرتفع). والرياح تهب دائماً من مناطق الضغط المرتفع إلى المنخفض.", {"h": "الرياح في الوطن العربي"}, "1) الرياح التجارية الشمالية الشرقية: جافة تهب معظم العام على الصحراء. 2) الرياح الغربية العكسية: تهب شتاءً على الأطراف الشمالية من البحر المتوسط فتجلب الأمطار. 3) الرياح الموسمية: تؤثر في جنوب الجزيرة العربية (اليمن وعُمان) وجنوب السودان والصومال صيفاً فتسقط الأمطار. 4) الرياح المحلية الحارة: القبلي في ليبيا، والخماسين في مصر، والسموم في الجزيرة العربية والعراق، والسيروكو في المغرب العربي، تهب من الصحراء محمّلة بالغبار في الربيع غالباً."]}], "lead": "استمع إلى الدرس، وتابع خريطة الوطن العربي في كتابك."}, {"title": "طابق", "eyebrow": "الخطوة ٢ — طابق", "heading": "الرياح وأثرها", "blocks": [{"type": "choice", "star": true, "items": [{"q": "جافة تهب على الصحراء معظم العام:", "a": "التجارية", "o": ["التجارية", "الغربية"]}, {"q": "تجلب أمطار الشتاء للشمال:", "a": "الغربية", "o": ["الغربية", "التجارية"]}, {"q": "تمطر اليمن صيفاً:", "a": "الموسمية", "o": ["الموسمية", "القبلي"]}, {"q": "رياح حارة في ليبيا:", "a": "القبلي", "o": ["القبلي", "السموم"]}, {"q": "رياح حارة في مصر:", "a": "الخماسين", "o": ["الخماسين", "السيروكو"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "الرياح", "meaning": "تهب من الضغط المرتفع إلى المنخفض", "ex": ""}, {"must": 1, "term": "المحلية الحارة", "meaning": "القبلي، الخماسين، السموم، السيروكو", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "يقاس الضغط الجوي بـ:", "a": "البارومتر", "o": ["البارومتر", "الترمومتر"], "ar": true, "why": ""}, {"q": "الضغط ينخفض حيث ترتفع الحرارة.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}