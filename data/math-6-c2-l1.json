   "blocks": [
    {
     "type": "steps",
     "star": true,
     "examples": [
      {
       "q": "زاويتان على خط مستقيم، إحداهما 125°. أوجد الأخرى.",
       "steps": [
        "مجموعهما 180°",
        "180 − 125 = 55°"
       ]
      },
      {
       "q": "مثلث فيه زاويتان 50° و 70°. أوجد الثالثة.",
       "steps": [
        "مجموع زوايا المثلث 180°",
        "50 + 70 = 120",
        "180 − 120 = 60°"
       ]
      },
      {
       "q": "شكل رباعي فيه ثلاث زوايا: 90° و 80° و 100°. أوجد الرابعة.",
       "steps": [
        "مجموع زوايا الرباعي 360°",
        "90 + 80 + 100 = 270",
        "360 − 270 = 90°"
       ]
      }
     ]
    }
   ]
