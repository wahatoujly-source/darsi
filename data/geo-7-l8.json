تحسن الخدمات الصحية", "زيادة الوفيات"]}, {"q": "حصر شامل للسكان:", "a": "التعداد", "o": ["التعداد", "الهجرة"]}, {"q": "المجتمع الليبي:", "a": "فتي", "o": ["فتي", "مسن"]}]}]}, {"title": "احسب", "eyebrow": "الخطوة ٣ — احسب", "heading": "", "blocks": [{"type": "calc", "star": true, "items": [{"q": "مواليد 30 ووفيات 5 لكل ألف، الزيادة الطبيعية لكل ألف:", "a": 25}, {"q": "قادمون 500 ومغادرون 200، صافي الهجرة:", "a": 300}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "النمو السكاني", "meaning": "الزيادة في عدد السكان", "ex": ""}, {"must": 1, "term": "الزيادة الطبيعية", "meaning": "المواليد − الوفيات", "ex": ""}, {"must": 1, "term": "التعداد", "meaning": "حصر شامل للسكان", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "انخفاض الوفيات من أسباب زيادة السكان.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "يُجرى التعداد عادة كل:", "a": "عشر سنوات", "o": ["عشر سنوات", "سنة"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}