   "heading": "جمع وطرح الكسور الجبرية ذات المقامات العددية",
   "blocks": [
    {
     "type": "reading",
     "star": true,
     "lang": "ar",
     "paragraphs": [
      "لجمع أو طرح كسور جبرية مقاماتها أعداد، نوحّد المقامات بإيجاد المضاعف المشترك الأصغر (م.م.أ) لها.",
      "مثال: س/2 + س/3 = 3س/6 + 2س/6 = 5س/6.",
      "مثال: (س + 1)/4 − (س − 2)/6 = 3(س + 1)/12 − 2(س − 2)/12 = (3س + 3 − 2س + 4)/12 = (س + 7)/12.",
      "انتبه إلى الإشارة السالبة قبل القوس: فهي تغيّر إشارة كل حد داخله."
     ]
    }
   ],
   "lead": "استمع إلى الشرح. كتابك ص 42–45."
  },
  {
   "title": "أمثلة",
   "eyebrow": "الخطوة ٢ — أمثلة",
   "heading": "خطوة بخطوة",
   "blocks": [
    {
     "type": "steps",
     "star": true,
     "examples": [
      {
       "q": "احسب: س/2 + س/3",
       "steps": [
        "م.م.أ للعددين 2 و 3 هو 6.",
        "س/2 = 3س/6، و س/3 = 2س/6",
        "الناتج: 5س/6"
       ]
      },
      {
       "q": "احسب: (س + 1)/4 − (س − 2)/6",
       "steps": [
        "م.م.أ = 12",
        "3(س + 1)/12 − 2(س − 2)/12",
        "(3س + 3 − 2س + 4)/12",
        "= (س + 7)/12"
       ]
      }
     ]
    }
   ]
