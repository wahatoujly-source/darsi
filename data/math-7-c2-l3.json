       "q": "اكتب كسراً مكافئاً للكسر 3/4 مقامه 20",
       "steps": [
        "4 × 5 = 20",
        "نضرب البسط أيضاً في 5: 3 × 5 = 15",
        "3/4 = 15/20"
       ]
      },
      {
       "q": "بسّط 18/24",
       "steps": [
        "العامل المشترك الأكبر 6",
        "18 ÷ 6 = 3، و 24 ÷ 6 = 4",
        "18/24 = 3/4"
       ]
      }
     ]
    }
