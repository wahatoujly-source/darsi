oke=\"#e0e0e0\"/><line x1=\"280\" y1=\"40\" x2=\"280\" y2=\"320\" stroke=\"#e0e0e0\"/><line x1=\"40\" y1=\"264\" x2=\"340\" y2=\"264\" stroke=\"#e0e0e0\"/><line x1=\"310\" y1=\"40\" x2=\"310\" y2=\"320\" stroke=\"#e0e0e0\"/><line x1=\"40\" y1=\"292\" x2=\"340\" y2=\"292\" stroke=\"#e0e0e0\"/><line x1=\"340\" y1=\"40\" x2=\"340\" y2=\"320\" stroke=\"#e0e0e0\"/><line x1=\"40\" y1=\"320\" x2=\"340\" y2=\"320\" stroke=\"#e0e0e0\"/><line x1=\"40\" y1=\"180\" x2=\"340\" y2=\"180\" stroke=\"#37474f\" stroke-width=\"2\"/><line x1=\"190\" y1=\"40\" x2=\"190\" y2=\"320\" stroke=\"#37474f\" stroke-width=\"2\"/><text x=\"345\" y=\"185\" font-size=\"13\">س</text><text x=\"195\" y=\"38\" font-size=\"13\">ص</text><circle class=\"pt\" style=\"animation-delay:0.0s\" cx=\"130\" cy=\"264\" r=\"6\" fill=\"#e53935\"/><circle class=\"pt\" style=\"animation-delay:0.7s\" cx=\"190\" cy=\"152\" r=\"6\" fill=\"#e53935\"/><circle class=\"pt\" style=\"animation-delay:1.4s\" cx=\"250\" cy=\"40\" r=\"6\" fill=\"#e53935\"/><line class=\"ln\" x1=\"100\" y1=\"320\" x2=\"265\" y2=\"12\" stroke=\"#1e88e5\" stroke-width=\"3\"/><text x=\"250\" y=\"70\" font-size=\"14\" fill=\"#1565c0\" direction=\"ltr\">y = 2x + 1</text><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">نعيّن النقاط ثم نصل بينها</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">فنحصل على خط مستقيم</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["العلاقة الخطية تمثَّل بيانياً بخط مستقيم، ومعادلتها: ص = م س + ج، حيث م الميل و ج المقطع الصادي (نقطة تقاطع الخط مع محور الصادات).", "الميل = التغير في ص ÷ التغير في س = (ص₂ − ص₁) ÷ (س₂ − س₁). الميل الموجب: الخط صاعد، والسالب: هابط.", "رسم الخط: نكوّن جدول قيم (نختار قيماً لـ س ونحسب ص)، ونعيّن النقاط ونصل بينها.", "مثال: ص = 2س + 1: عندما س = 0، ص = 1؛ س = 1، ص = 3؛ س = 2، ص = 5. الميل 2 والمقطع الصادي 1.", "تطبيق: أجرة سيارة = 5 دنانير ثابتة + 2 دينار لكل كم: ص = 2س + 5."]}], "lead": "استمع إلى الشرح، وتابع الأمثلة خطوة بخطوة."}, {"title": "أمثلة", "eyebrow": "الخطوة ٢ — أمثلة", "heading": "خطوة بخطوة", "blocks": [{"type": "steps", "star": true, "examples": [{"q": "أوجد ميل الخط المار بـ (1، 2) و(3، 8)", "steps": ["الميل = (8 − 2) ÷ (3 − 1)", "= 6 ÷ 2 = 3"]}, {"q": "في ص = −3س + 4 أوجد الميل والمقطع", "steps": ["الميل م = −3 (هابط)", "المقطع الصادي ج = 4"]}]}]}, {"title": "احسب", "eyebrow": "الخطوة ٣ — احسب", "heading": "", "blocks": [{"type": "calc", "star": true, "items": [{"q": "ميل الخط بين (0، 0) و(2، 6):", "a": 3}, {"q": "ميل الخط بين (1، 1) و(3، 5):", "a": 2}, {"q": "في ص = 4س + 7 المقطع الصادي:", "a": 7}, {"q": "ص = 2س + 1، س = 4، ص = ؟", "a": 9}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "معادلة الخط", "meaning": "ص = م س + ج", "ex": ""}, {"must": 1, "term": "الميل", "meaning": "(ص₂ − ص₁) ÷ (س₂ − س₁)", "ex": ""}, {"must": 1, "term": "المقطع الصادي", "meaning": "قيمة ص عندما س = 0", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"type": "input", "q": "ميل الخط المار بـ (2، 3) و(4، 11)؟", "a": 4, "why": ""}, {"q": "الخط ص = −2س + 1:", "a": "هابط", "o": ["هابط", "صاعد"], "ar": true, "why": ""}, {"type": "input", "q": "ص = 3س + 2، المقطع الصادي؟", "a": 2, "why": ""}]}], "lead": "3 أسئلة. تنجح بـ 2 من 3."}]}