0px;margin:0 auto\"><svg viewBox=\"0 0 380 370\" role=\"img\" aria-label=\"تيار الحمل: الساخن يرتفع والبارد ينزل\" style=\"width:100%;height:auto;display:block;border-radius:16px;background:#dff1fb\" xmlns=\"http://www.w3.org/2000/svg\"><style>.fl{transform-origin:190px 330px;animation:fl .5s ease-in-out infinite alternate}@keyframes fl{to{transform:scaleY(1.15)}}@media (prefers-reduced-motion:reduce){*{animation:none!important}}</style><path d=\"M90,110 L90,260 Q90,280 110,280 L270,280 Q290,280 290,260 L290,110\" fill=\"#bbdefb\" stroke=\"#37474f\" stroke-width=\"4\"/><g class=\"fl\"><path d=\"M190,330 C170,305 182,290 190,278 C198,290 210,305 190,330Z\" fill=\"#ff7043\"/></g><path id=\"cv\" d=\"M190,250 C190,170 250,140 250,190 C250,240 190,250 190,250 M190,250 C190,170 130,140 130,190 C130,240 190,250 190,250\" fill=\"none\" stroke=\"#e53935\" stroke-width=\"2\" stroke-dasharray=\"6 6\" opacity=\".6\"/><circle r=\"6\" fill=\"#e53935\"><animateMotion dur=\"4s\" begin=\"0s\" repeatCount=\"indefinite\" path=\"M190,250 C190,170 250,140 250,190 C250,240 190,250 190,250\"/></circle><circle r=\"6\" fill=\"#1e88e5\"><animateMotion dur=\"4s\" begin=\"2s\" repeatCount=\"indefinite\" path=\"M190,250 C190,170 250,140 250,190 C250,240 190,250 190,250\"/></circle><circle r=\"6\" fill=\"#e53935\"><animateMotion dur=\"4s\" begin=\"1s\" repeatCount=\"indefinite\" path=\"M190,250 C190,170 130,140 130,190 C130,240 190,250 190,250\"/></circle><circle r=\"6\" fill=\"#1e88e5\"><animateMotion dur=\"4s\" begin=\"3s\" repeatCount=\"indefinite\" path=\"M190,250 C190,170 130,140 130,190 C130,240 190,250 190,250\"/></circle><text x=\"190.0\" y=\"339\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">تيار الحمل: الساخن</text><text x=\"190.0\" y=\"358\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">يرتفع والبارد ينزل</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["الحرارة شكل من أشكال الطاقة، تنتقل دائماً من الجسم الأسخن إلى الأبرد.", "نقيس درجة الحرارة بالترمومتر بالدرجة المئوية (°س).", "طرق انتقال الحرارة: 1) التوصيل: في المواد الصلبة، كسخونة الملعقة المعدنية في الشاي. 2) الحمل: في السوائل والغازات، فالهواء الساخن يصعد إلى أعلى. 3) الإشعاع: دون وسط، كحرارة الشمس التي تصلنا عبر الفضاء.", "الموصلات الجيدة: المعادن (الحديد والنحاس والألمنيوم)، لذلك تُصنع منها القدور. والعوازل: الخشب والبلاستيك والصوف والهواء، لذلك تُصنع منها مقابض القدور والملابس الشتوية.", "التمدد: معظم المواد تتمدد بالحرارة وتنكمش بالبرودة، لذلك تُترك فراغات بين قضبان السكك الحديدية."]}], "lead": "اقرأ واستمع، وتأمّل الصورة المتحركة."}, {"title": "طريقة الانتقال", "eyebrow": "الخطوة ٢ — طريقة الانتقال", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "ملعقة تسخن في الشاي", "a": "توصيل", "o": ["توصيل", "إشعاع"]}, {"q": "حرارة الشمس", "a": "إشعاع", "o": ["إشعاع", "حمل"]}, {"q": "صعود الهواء الساخن", "a": "حمل", "o": ["حمل", "توصيل"]}]}]}, {"title": "موصل أم عازل؟", "eyebrow": "الخطوة ٣ — موصل أم عازل؟", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "النحاس", "a": "موصل", "o": ["موصل", "عازل"]}, {"q": "الخشب", "a": "عازل", "o": ["موصل", "عازل"]}, {"q": "الصوف", "a": "عازل", "o": ["موصل", "عازل"]}, {"q": "الألمنيوم", "a": "موصل", "o": ["موصل", "عازل"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "انتقال الحرارة", "meaning": "من الأسخن إلى الأبرد", "ex": ""}, {"must": 1, "term": "الطرق", "meaning": "توصيل، حمل، إشعاع", "ex": ""}, {"must": 1, "term": "التمدد", "meaning": "المواد تتمدد بالحرارة", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "مقبض القدر يُصنع من مادة عازلة.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "نقيس الحرارة بـ:", "a": "الترمومتر", "o": ["الترمومتر", "المسطرة"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}