: "الإقليم الصحراوي", "o": ["الإقليم الصحراوي", "مناخ البحر المتوسط"]}, {"q": "يظهر على أعالي الجبل الأخضر:", "a": "مناخ البحر المتوسط", "o": ["مناخ البحر المتوسط", "الإستبس"]}, {"q": "يشمل سواحل خليج سرت:", "a": "الإستبس", "o": ["الإستبس", "مناخ البحر المتوسط"]}, {"q": "أمطاره أقل من 50 ملم:", "a": "الإقليم الصحراوي", "o": ["الإقليم الصحراوي", "المرتفعات الشمالية"]}]}]}, {"title": "رتّب", "eyebrow": "الخطوة ٣ — رتّب", "heading": "رتّب الأقاليم من الأكثر مطراً إلى الأقل", "blocks": [{"type": "sequence", "star": true, "items": [{"q": "من الأكثر أمطاراً إلى الأقل", "order": ["مناخ البحر المتوسط", "إقليم الإستبس", "الإقليم شبه الصحراوي", "الإقليم الصحراوي"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "عدد الأقاليم المناخية", "meaning": "خمسة أقاليم", "ex": ""}, {"must": 1, "term": "الإقليم الصحراوي", "meaning": "يسود الوسط والجنوب، وأمطاره أقل من 50 ملم", "ex": ""}, {"must": 1, "term": "إقليم الإستبس", "meaning": "حار صيفاً دافئ شتاءً، وأمطاره أقل من 250 ملم", "ex": ""}, {"must": 1, "term": "مناخ البحر المتوسط", "meaning": "أعالي الجبل الأخضر، وأمطاره أكثر من 350 ملم", "ex": ""}, {"must": 1, "term": "90%", "meaning": "من مساحة ليبيا تقع تحت تأثير المناخ الصحراوي", "ex": "", "tip": "رقم مهم للامتحان."}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 4, "items": [{"type": "input", "q": "كم إقليماً مناخياً في ليبيا؟", "a": 5, "why": ""}, {"type": "input", "q": "كم في المئة من مساحة ليبيا تحت تأثير المناخ الصحراوي؟", "a": 90, "why": ""}, {"q": "إقليم مناخ الإستبس:", "a": "حار صيفاً دافئ شتاءً", "o": ["حار صيفاً دافئ شتاءً", "بارد طوال العام"], "ar": true, "why": ""}, {"q": "مناخ البحر المتوسط يظهر في