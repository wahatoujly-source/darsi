     "paragraphs": [
      {
       "h": "النص"
      },
      "للإنسانية أعداء يهددون حياة البشر وسعادتهم: الجهل، والفقر، والمرض، والحروب.",
      "فالجهل يعمي العقول، والفقر يذل النفوس، والمرض يضعف الأجسام، والحروب تدمر العمران وتقتل الأبرياء.",
      "ويُحارَب الجهل بالتعليم، والفقر بالعمل والتكافل، والمرض بالعلم والطب، والحروب بالسلام والعدل والحوار.",
      "وكل واحد منا يستطيع أن يسهم في هذه المعركة بعلمه وعمله وأخلاقه.",
      {
       "h": "القيمة"
      },
      "نبذ الشرور",
      {
       "h": "القواعد: كان وأخواتها"
      },
      "كان وأخواتها أفعال ناسخة تدخل على الجملة الاسمية، فترفع المبتدأ ويسمى اسمها، وتنصب الخبر ويسمى خبرها: كان الجوُّ ممطراً.",
      "أخواتها: أصبح، أضحى، أمسى، ظلّ، بات، صار، ليس، ما زال، ما دام."
     ]
    }
   ],
   "lead": "اقرأ النص واستمع إليه."
