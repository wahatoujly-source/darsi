     "star": true,
     "examples": [
      {
       "q": "حوّل 11/3 إلى عدد كسري",
       "steps": [
        "11 ÷ 3 = 3 والباقي 2",
        "3 هو العدد الصحيح، و 2 البسط، و 3 المقام",
        "11/3 = 3⅔"
       ]
      },
      {
       "q": "حوّل 2⅗ إلى كسر غير فعلي",
       "steps": [
        "2 × 5 = 10",
        "10 + 3 = 13",
        "2⅗ = 13/5"
       ]
      }
