ht=\"45\" fill=\"#cfe8ff\"/><text x=\"352\" y=\"315\" font-size=\"12\" direction=\"rtl\" text-anchor=\"start\" fill=\"#29434e\">قطبي</text><line x1=\"20\" y1=\"175\" x2=\"360\" y2=\"175\" stroke=\"#c62828\" stroke-width=\"2\" stroke-dasharray=\"6 4\"/><text x=\"26\" y=\"170\" font-size=\"11\" direction=\"rtl\" text-anchor=\"end\" fill=\"#c62828\">خط الاستواء</text><g class=\"sn\"><circle cx=\"60\" cy=\"175\" r=\"16\" fill=\"#ffca28\"/></g><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الشمس عمودية قرب خط الاستواء</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">فتتوزع الأقاليم على شكل نطاقات</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["أستراليا أجف القارات المأهولة. يمر مدار الجدي بوسطها فتسود الرياح التجارية الجافة على الداخل والغرب، والسلسلة المقسِّمة العظمى تحجز الرطوبة القادمة من الهادي عن الداخل فتسقط أمطارها على الساحل الشرقي.", "الشمال حار ممطر صيفاً (رياح موسمية)، والجنوب الشرقي والجنوب الغربي معتدلان بمطر شتوي، والداخل صحراوي شديد الحرارة. وتذكّر أن الفصول فيها عكس فصولنا لوقوعها جنوب خط الاستواء: الصيف من ديسمبر إلى فبراير."]}], "lead": "استمع إلى الدرس، وتابع الخريطة في كتابك."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "أجف القارات المأهولة:", "a": "أستراليا", "o": ["أستراليا", "أوروبا"]}, {"q": "يتركز المطر على الساحل:", "a": "الشرقي", "o": ["الشرقي", "الغربي الداخلي"]}, {"q": "الصيف في أستراليا:", "a": "ديسمبر–فبراير", "o": ["ديسمبر–فبراير", "يونيو–أغسطس"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "المناخ", "meaning": "أجف القارات المأهولة", "ex": ""}, {"must": 1, "term": "الفصول", "meaning": "عكس فصول نصف الكرة الشمالي", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "داخل أستراليا صحراوي.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "سبب جفاف الداخل:", "a": "الرياح التجارية الجافة وحجز الجبال للرطوبة", "o": ["الرياح التجارية الجافة وحجز الجبال للرطوبة", "كثرة البحيرات"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}