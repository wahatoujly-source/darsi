th=\"3\" fill=\"none\" class=\"ev\" style=\"animation-delay:1.6s\"/><g><animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0;150 0;150 0;0 0\" keyTimes=\"0;.5;.9;1\" dur=\"8s\" repeatCount=\"indefinite\"/><ellipse cx=\"110\" cy=\"90\" rx=\"45\" ry=\"22\" fill=\"#fff\"/><ellipse cx=\"140\" cy=\"80\" rx=\"35\" ry=\"20\" fill=\"#fff\"/></g><line x1=\"245\" y1=\"120\" x2=\"240\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.0s\"/><line x1=\"257\" y1=\"120\" x2=\"252\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.15s\"/><line x1=\"269\" y1=\"120\" x2=\"264\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.3s\"/><line x1=\"281\" y1=\"120\" x2=\"276\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.44999999999999996s\"/><line x1=\"293\" y1=\"120\" x2=\"288\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.6s\"/><line x1=\"305\" y1=\"120\" x2=\"300\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.75s\"/><line x1=\"317\" y1=\"120\" x2=\"312\" y2=\"132\" stroke=\"#1e88e5\" stroke-width=\"2\" class=\"rn\" style=\"animation-delay:0.8999999999999999s\"/><path class=\"rv\" d=\"M300,160 Q250,220 170,268\" stroke=\"#29b6f6\" stroke-width=\"4\" fill=\"none\"/><text x=\"85\" y=\"200\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"bold\" fill=\"#0d47a1\">تبخر</text><text x=\"200\" y=\"60\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"bold\" fill=\"#0d47a1\">تكاثف</text><text x=\"300\" y=\"105\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"bold\" fill=\"#0d47a1\">هطول</text><text x=\"240\" y=\"240\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"bold\" fill=\"#0d47a1\">جريان</text><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">دورة الماء: تبخر ←</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">تكاثف ← هطول ← جريان</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["المياه الجوفية: مياه الأمطار التي تتسرب عبر التربة والصخور المسامية وتتجمع في باطن الأرض في طبقات تسمى «الخزانات الجوفية».", "نستخرجها بحفر الآبار، وقد تخرج بنفسها على شكل عيون وينابيع (مثل عين الفرس في غدامس قديماً).", "المياه الجوفية هي المصدر الرئيسي للمياه في ليبيا (أكثر من 95%). وأكبر الخزانات في الجنوب: الكفرة والسرير ومرزق والحمادة، وهي مياه قديمة تجمعت منذ آلاف السنين عندما كانت الصحراء ممطرة.", "النهر الصناعي العظيم: مشروع ضخم بدأ في الثمانينيات، ينقل ملايين الأمتار المكعبة من المياه الجوفية يومياً عبر أنابيب عملاقة من الجنوب إلى مدن الساحل.", "مشكلات: استنزاف المياه الجوفية لأنها لا تتجدد بسرعة، وتسرّب مياه البحر المالحة إلى الآبار الساحلية."]}], "lead": "اقرأ مع معلمك، وتأمّل الصورة المتحركة."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "المصدر الرئيسي للمياه في ليبيا:", "a": "المياه الجوفية", "o": ["المياه الجوفية", "الأنهار"]}, {"q": "نستخرج المياه الجوفية بـ:", "a": "الآبار", "o": ["الآبار", "السدود"]}, {"q": "خزان جوفي في الجنوب:", "a": "الكفرة", "o": ["الكفرة", "طرابلس"]}, {"q": "من مشكلات المياه الجوفية:", "a": "الاستنزاف", "o": ["الاستنزاف", "كثرتها"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "المياه الجوفية", "meaning": "مياه مخزنة في باطن الأرض", "ex": ""}, {"must": 1, "term": "النهر الصناعي", "meaning": "ينقلها من الجنوب للشمال", "ex": ""}, {"must": 1, "term": "الاستنزاف", "meaning": "خطر يهددها", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 1, "items": [{"q": "المياه الجوفية في ليبيا تتجدد بسرعة.", "a": "خطأ", "o": ["صح", "خطأ"], "ar": true, "why": ""}]}], "lead": "1 أسئلة. تنجح بـ 1 من 1."}]}