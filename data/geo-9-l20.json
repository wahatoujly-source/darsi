class=\"pp\" style=\"animation-delay:3.00s\" x=\"96\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.25s\" x=\"129\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.50s\" x=\"162\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.75s\" x=\"195\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.00s\" x=\"228\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.25s\" x=\"261\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.50s\" x=\"294\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.75s\" x=\"327\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.00s\" x=\"30\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.25s\" x=\"63\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.50s\" x=\"96\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.75s\" x=\"129\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.00s\" x=\"162\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.25s\" x=\"195\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.50s\" x=\"228\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.75s\" x=\"261\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.00s\" x=\"294\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.25s\" x=\"327\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.50s\" x=\"30\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.75s\" x=\"63\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.00s\" x=\"96\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.25s\" x=\"129\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.50s\" x=\"162\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.75s\" x=\"195\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.00s\" x=\"228\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.25s\" x=\"261\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.50s\" x=\"294\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.75s\" x=\"327\" y=\"245\" font-size=\"24\">🧍</text><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">يتركّز السكان حيث الماء والتربة</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الخصبة والمناخ المعتدل</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["يبلغ سكان أوروبا نحو 740 مليون نسمة، وهي من أعلى القارات كثافة. ويتركز السكان في السهل الأوروبي العظيم، ووديان الأنهار كالراين، ومناطق المعادن والصناعة، والمدن الكبرى مثل لندن وباريس وموسكو وبرلين وروما. ويقل السكان في الشمال البارد والجبال العالية.", {"h": "خصائص السكان"}, "نسبة سكان المدن مرتفعة، والنمو السكاني بطيء، وترتفع نسبة كبار السن، ولذلك تحتاج بعض الدول إلى العمالة المهاجرة.", {"h": "اللغات والسلالات"}, "ينتمي أغلب السكان إلى الجنس القوقازي، وتتعدد لغاتهم: لاتينية (الإيطالية والفرنسية والإسبانية)، وجرمانية (الألمانية والإنجليزية)، وسلافية (الروسية والبولندية).", {"h": "الاتحاد الأوروبي"}, "تكتل اقتصادي وسياسي يضم عدداً كبيراً من الدول الأوروبية، له عملة موحّدة (اليورو) في كثير من دوله، ويسهّل التنقل والتجارة بينها."]}], "lead": "استمع إلى الدرس، وتابع الخريطة في كتابك."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "يتركز السكان في:", "a": "السهل الأوروبي العظيم", "o": ["السهل الأوروبي العظيم", "أقصى الشمال"]}, {"q": "النمو السكاني في أوروبا:", "a": "بطيء", "o": ["بطيء", "سريع جداً"]}, {"q": "عملة الاتحاد الأوروبي:", "a": "اليورو", "o": ["اليورو", "الدينار"]}, {"q": "الروسية من اللغات:", "a": "السلافية", "o": ["السلافية", "اللاتينية"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "سكان أوروبا", "meaning": "نحو 740 مليوناً، كثافة عالية", "ex": ""}, {"must": 1, "term": "الخصائص", "meaning": "تحضر مرتفع، نمو بطيء، كبار سن", "ex": ""}, {"must": 1, "term": "الاتحاد الأوروبي", "meaning": "تكتل اقتصادي وعملة اليورو", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "ترتفع نسبة كبار السن في أوروبا.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "الفرنسية لغة:", "a": "لاتينية", "o": ["لاتينية", "سلافية"], "ar": true, "why": ""}, {"q": "من المدن الكبرى:", "a": "باريس", "o": ["باريس", "الكفرة"], "ar": true, "why": ""}]}], "lead": "3 أسئلة. تنجح بـ 2 من 3."}]}