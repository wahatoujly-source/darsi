     "lang": "ar",
     "paragraphs": [
      "الوقت: 1 ساعة = 60 دقيقة، ونظام 24 ساعة: 3:30 م = 15:30. ونحسب المدة بين وقتين.",
      "السرعة = المسافة ÷ الزمن (كم/س أو م/ث). والمسافة = السرعة × الزمن. والزمن = المسافة ÷ السرعة.",
      "السرعة المتوسطة = المسافة الكلية ÷ الزمن الكلي."
     ]
    }
   ],
   "lead": "كراستك ص 89⁠–⁠91."
