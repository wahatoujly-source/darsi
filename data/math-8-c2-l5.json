      {
       "q": "4 عمال ينجزون عملاً في 6 أيام، فكم يوماً يحتاج 8 عمال؟",
       "steps": [
        "تناسب عكسي: عمال أكثر ⇐ أيام أقل.",
        "حاصل الضرب ثابت: 4 × 6 = 24",
        "24 ÷ 8 = 3 أيام"
       ]
      },
      {
       "q": "سيارة تحتاج 3 ساعات بسرعة 80 كم/س، فكم تحتاج بسرعة 60 كم/س؟",
       "steps": [
        "المسافة = 3 × 80 = 240 كم",
        "الزمن = 240 ÷ 60 = 4 ساعات"
