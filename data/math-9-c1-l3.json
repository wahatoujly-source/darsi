       "q": "احسب ذهنياً: 52 × 48",
       "steps": [
        "52 = 50 + 2، و 48 = 50 − 2",
        "(50 + 2)(50 − 2) = 50² − 2²",
        "2500 − 4 = 2496"
       ]
      }
     ]
