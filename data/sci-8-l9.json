 q20,-15 35,5 q10,20 30,10 q5,25 -20,30 q-25,0 -45,-45z\" fill=\"#66bb6a\"/><path class=\"ry\" style=\"animation-delay:0.0s\" d=\"M110,105 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:0.5s\" d=\"M110,117 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:1.0s\" d=\"M110,129 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:1.5s\" d=\"M110,141 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#fff\">تصلنا حرارة الشمس</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#fff\">بالإشعاع عبر الفضاء</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["على عكس التوصيل والحمل، لا يحتاج الإشعاع إلى وسط، فهو موجات كهرومغناطيسية تنتقل عبر الفراغ التام؛ وهكذا تصلنا حرارة الشمس، أكبر مشع معروف.", {"h": "عوامل تؤثر في الإشعاع والامتصاص"}, "درجة الحرارة: ترمومتر على بعد 5 سم من مصباح 100 وات يسجل حرارة أعلى من مصباح 60 وات؛ فالجسم الأسخن يشع حرارة بمعدل أعلى.", "حالة سطح الجسم المشع: خزان ماء يغلي له وجه لامع مصقول ووجه أسود معتم؛ الترمومتر أمام الوجه المعتم يسجل حرارة أعلى. السطح المعتم الأسود يشع أكثر من اللامع.", "حالة سطح الجسم الماص: ترمومتر بصيلته مطلية بالحبر الأسود يرتفع أسرع من آخر لامع؛ السطح الأسود يمتص الحرارة أسرع.", {"h": "تطبيقات"}, "السخانات الشمسية على أسطح المنازل لها ألواح سوداء لامتصاص أشعة الشمس.", "دورق حفظ الحرارة (الترمس): جدار زجاجي مزدوج بينهما فراغ يمنع التوصيل والحمل، وطبقة فضية لامعة تقلل الإشعاع، وسدادة من اللدائن الرديئة التوصيل.", "ريش تبريد محرك الدراجة النارية مطلية بالأسود وكثيرة لتزيد المساحة فتشع الحرارة بسرعة.", "نلبس ملابس فاتحة اللون في الصيف لأنها تعكس الحرارة ولا تمتصها.", "تنبيه: التعرض الزائد لأشعة الشمس قد يسبب سرطان الجلد."]}], "lead": "استمع إلى الدرس. كتابك ص 42–45."}, {"title": "أسود أم لامع؟", "eyebrow": "الخطوة ٢ — أسود أم لامع؟", "heading": "اختر", "blocks": [{"type": "choice", "star": true, "items": [{"q": "الأسرع امتصاصاً للحرارة:", "a": "السطح الأسود المعتم", "o": ["السطح الأسود المعتم", "السطح الأبيض اللامع"]}, {"q": "الأفضل لملابس الصيف:", "a": "الألوان الفاتحة", "o": ["الألوان الفاتحة", "الألوان الداكنة"]}, {"q": "ألواح السخان الشمسي:", "a": "سوداء", "o": ["سوداء", "فضية"]}, {"q": "جدار الترمس من الداخل:", "a": "فضي لامع", "o": ["فضي لامع", "أسود"]}]}]}, {"title": "الترمس", "eyebrow": "الخطوة ٣ — الترمس", "heading": "كيف يمنع فقد الحرارة؟", "blocks": [{"type": "choice", "star": true, "items": [{"q": "الفراغ بين الجدارين يمنع:", "a": "التوصيل والحمل", "o": ["التوصيل والحمل", "الإشعاع فقط"]}, {"q": "الطبقة الفضية تقلل:", "a": "الإشعاع", "o": ["الإشعاع", "التوصيل"]}, {"q": "السدادة من:", "a": "اللدائن", "o": ["اللدائن", "الحديد"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "الإشعاع", "meaning": "لا يحتاج وسطاً وينتقل في الفراغ", "ex": ""}, {"must": 1, "term": "السطح الأسود المعتم", "meaning": "يشع ويمتص الحرارة أكثر", "ex": ""}, {"must": 1, "term": "السطح اللامع الفاتح", "meaning": "يعكس الحرارة ويشع أقل", "ex": ""}, {"must": 1, "term": "الترمس", "meaning": "فراغ + طبقة فضية + سدادة عازلة", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 3, "items": [{"q": "تصلنا حرارة الشمس عبر الفضاء بـ:", "a": "الإشعاع", "o": ["الإشعاع", "الحمل"], "ar": true, "why": ""}, {"q": "السطح اللامع يمتص الحرارة أسرع من الأسود.", "a": "خطأ", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "ريش تبريد المحرك تُطلى بالأسود لكي:", 