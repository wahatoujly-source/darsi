x=\"306\" y=\"252\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">الكفرة</text></g><g class=\"cy\" style=\"animation-delay:3.5s\"><circle cx=\"320\" cy=\"78\" r=\"5\" fill=\"#c0392b\" fill-opacity=\".8\"/><circle class=\"pl\" style=\"animation-delay:3.5s;transform-origin:320px 78px\" cx=\"320\" cy=\"78\" r=\"5\" fill=\"none\" stroke=\"#c0392b\" stroke-width=\"2\"/><text x=\"320\" y=\"95\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">طبرق</text></g><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">يتركز السكان والمدن</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الكبرى على الساحل</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["توزيع السكان في ليبيا غير متوازن: يتركز أكثر من 85% منهم في الشريط الساحلي الشمالي، خاصة في سهل الجفارة حول طرابلس، وسهل بنغازي والجبل الأخضر.", "أسباب التركز في الشمال: المناخ المعتدل وكفاية الأمطار، والتربة الخصبة، وتوفر المياه، ووجود الموانئ والمدن والخدمات وفرص العمل.", "المناطق قليلة السكان: الصحراء الواسعة في الوسط والجنوب، بسبب الجفاف وقلة الماء وارتفاع الحرارة؛ ويتركز السكان فيها حول الواحات كسبها ومرزق وغات والكفرة وغدامس.", "الكثافة السكانية = عدد السكان ÷ المساحة. كثافة ليبيا العامة منخفضة جداً (نحو 4 أشخاص/كم²) لأن مساحتها شاسعة، لكنها مرتفعة في المدن الساحلية."]}], "lead": "اقرأ واستمع، وتأمّل الخريطة."}, {"title": "اختر", "eyebrow": "الخطوة ٢ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "يتركز معظم السكان في:", "a": "الساحل الشمالي", "o": ["الساحل الشمالي", "الصحراء"]}, {"q": "سكان الجنوب يتجمعون حول:", "a": "الواحات", "o": ["الواحات", "الجبال الجليدية"]}, {"q": "سبب قلة السكان في الصحراء:", "a": "الجفاف وقلة الماء", "o": ["الجفاف وقلة الماء", "كثرة الأمطار"]}]}]}, {"title": "احسب", "eyebrow": "الخطوة ٣ — احسب", "heading": "الكثافة = السكان ÷ المساحة", "blocks": [{"type": "calc", "star": true, "items": [{"q": "مدينة سكانها 10000 ومساحتها 50 كم²:", "a": 200}, {"q": "منطقة سكانها 6000 ومساحتها 3000 كم²:", "a": 2}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "توزيع السكان", "meaning": "غير متوازن، يتركز في الشمال", "ex": ""}, {"must": 1, "term": "الكثافة السكانية", "meaning": "السكان ÷ المساحة", "ex": ""}, {"must": 1, "term": "الواحات", "meaning": "مراكز الاستقرار في الصحراء", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "كثافة ليبيا العامة مرتفعة جداً.", "a": "خطأ", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"type": "input", "q": "كثافة منطقة سكانها 800 ومساحتها 4 كم²؟", "a": 200, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}