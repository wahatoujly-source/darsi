       "q": "حلّل: 6س² + 9س",
       "steps": [
        "ع.م.أ للعددين 6 و 9 هو 3.",
        "المتغير المشترك س بأصغر أس: س.",
        "ع.م.أ = 3س",
        "6س² + 9س = 3س (2س + 3)"
       ]
      },
      {
       "q": "حلّل: 10أ²ب − 15أب²",
       "steps": [
        "ع.م.أ للعددين 10 و 15 هو 5.",
        "المتغيرات المشتركة: أ ب.",
        "10أ²ب − 15أب² = 5أب (2أ − 3ب)"
       ]
      }
     ]
    }
