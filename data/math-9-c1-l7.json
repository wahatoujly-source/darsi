   "heading": "تحليل المقادير التربيعية الثلاثية",
   "blocks": [
    {
     "type": "reading",
     "star": true,
     "lang": "ar",
     "paragraphs": [
      "المقدار التربيعي الثلاثي صورته: س² + ب س + جـ.",
      "لتحليله نبحث عن عددين حاصل ضربهما يساوي جـ، ومجموعهما يساوي ب، فيكون: س² + ب س + جـ = (س + م)(س + ن).",
      "مثال: س² + 7س + 12: نبحث عن عددين حاصل ضربهما 12 ومجموعهما 7، هما 3 و 4، إذن س² + 7س + 12 = (س + 3)(س + 4).",
      "مثال: س² − س − 6: عددان حاصل ضربهما −6 ومجموعهما −1، هما −3 و 2، إذن = (س − 3)(س + 2).",
      "المربع الكامل: س² + 6س + 9 = (س + 3)²."
     ]
    }
   ],
   "lead": "استمع إلى الشرح. كتابك ص 25–28."
  },
  {
   "title": "أمثلة",
   "eyebrow": "الخطوة ٢ — أمثلة",
   "heading": "خطوة بخطوة",
   "blocks": [
    {
     "type": "steps",
     "star": true,
     "examples": [
      {
       "q": "حلّل: س² + 7س + 12",
       "steps": [
        "نريد عددين: حاصل ضربهما 12 ومجموعهما 7.",
        "1 × 12 (مجموع 13)، 2 × 6 (مجموع 8)، 3 × 4 (مجموع 7) ✓",
        "س² + 7س + 12 = (س + 3)(س + 4)"
       ]
      },
      {
       "q": "حلّل: س² − 5س + 6",
       "steps": [
        "حاصل الضرب +6 والمجموع −5 ⇐ العددان سالبان.",
        "−2 × −3 = 6، و −2 + (−3) = −5",
        "(س − 2)(س − 3)"
       ]
      },
      {
       "q": "حلّل: س² + 2س − 8",
       "steps": [
        "حاصل الضرب −8 ⇐ عددان مختلفا الإشارة.",
        "4 × (−2) = −8، و 4 + (−2) = 2",
        "(س + 4)(س − 2)"
       ]
      }
     ]
    }
   ]
