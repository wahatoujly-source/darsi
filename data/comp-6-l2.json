   "blocks": [
    {
     "type": "reading",
     "star": true,
     "lang": "ar",
     "paragraphs": [
      "الغرض من البرنامج التطبيقي مساعدة المستخدم في القيام بمهام محددة. ومن أهمها:",
      "معالجة النصوص: لإنشاء المستندات وتحريرها وحفظها وطباعتها، مثل Microsoft Word.",
      "إنشاء جداول البيانات الإلكترونية: لتخزين البيانات ضمن جداول وإجراء العمليات الحسابية، مثل Microsoft Excel.",
      "إنشاء قواعد البيانات: لتنظيم البيانات، مثل Microsoft Access.",
      "إنشاء العروض التقديمية: لعرض الأفكار على شكل شرائح، مثل Microsoft PowerPoint.",
      "تعديل الصور وإنشاء الرسومات: مثل Adobe Photoshop.",
      "متصفحات الإنترنت: للوصول إلى مواقع الويب، مثل Google Chrome و Microsoft Edge.",
      "البريد الإلكتروني: لإرسال واستقبال الرسائل، مثل Microsoft Outlook."
     ]
    }
   ],
   "lead": "استمع إلى الدرس. كتابك ص 10–12."
