l=\"#29b6f6\"><animateMotion dur=\"4s\" begin=\"2.5s\" repeatCount=\"indefinite\" path=\"M190,325 L190,100 L140,110\"/></circle><circle r=\"5\" fill=\"#29b6f6\"><animateMotion dur=\"4s\" begin=\"3.0s\" repeatCount=\"indefinite\" path=\"M190,325 L190,100 L240,95\"/></circle><circle r=\"5\" fill=\"#29b6f6\"><animateMotion dur=\"4s\" begin=\"3.5s\" repeatCount=\"indefinite\" path=\"M190,325 L190,100 L140,110\"/></circle><path class=\"vp\" style=\"animation-delay:0.0s\" d=\"M120,80 q-6,-12 0,-24\" stroke=\"#90a4ae\" stroke-width=\"3\" fill=\"none\"/><path class=\"vp\" style=\"animation-delay:0.7s\" d=\"M170,80 q-6,-12 0,-24\" stroke=\"#90a4ae\" stroke-width=\"3\" fill=\"none\"/><path class=\"vp\" style=\"animation-delay:1.4s\" d=\"M220,80 q-6,-12 0,-24\" stroke=\"#90a4ae\" stroke-width=\"3\" fill=\"none\"/><path class=\"vp\" style=\"animation-delay:2.0999999999999996s\" d=\"M270,80 q-6,-12 0,-24\" stroke=\"#90a4ae\" stroke-width=\"3\" fill=\"none\"/><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">يصعد الماء من الجذور عبر الخشب</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">ويتبخر من الأوراق (النتح)</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["المخلوقات وحيدة الخلية تحصل على حاجاتها بالانتشار مباشرة، أما المخلوقات الكبيرة متعددة الخلايا فالمسافة بين خلاياها والبيئة كبيرة، والانتشار وحده بطيء، لذلك تحتاج إلى جهاز نقل.", "في النباتات: ينتقل الماء والأملاح من الجذور إلى الساق ثم الأوراق عبر أنسجة الخشب. ويمكن إثبات ذلك بوضع ساق نبات (كالكرفس) في ماء ملوّن، فيظهر اللون في أوعية الخشب والأوراق بعد مدة.", "ويصعد الماء بفضل: سحب النتح من الأوراق (القوة الرئيسة)، والخاصية الشعرية في الأوعية الرفيعة، والضغط الجذري."]}], "lead": "استمع إلى الدرس، وشاهد المشهد، ثم تدرّب."}, {"title": "أفهم", "eyebrow": "الخطوة ٢ — أفهم", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "تحتاج المخلوقات الكبيرة جهاز نقل لأن:", "a": "الانتشار وحده بطيء", "o": ["الانتشار وحده بطيء", "لا تحتاج غذاء"]}, {"q": "ينقل الماء في النبات:", "a": "الخشب", "o": ["الخشب", "اللحاء"]}, {"q": "القوة الرئيسة لصعود الماء:", "a": "سحب النتح", "o": ["سحب النتح", "الجاذبية"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "جهاز النقل", "meaning": "ضروري للمخلوقات الكبيرة", "ex": ""}, {"must": 1, "term": "الخشب", "meaning": "ينقل الماء والأملاح لأعلى", "ex": ""}, {"must": 1, "term": "صعود الماء", "meaning": "النتح، الخاصية الشعرية، الضغط الجذري", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "تجربة الكرفس في الماء الملون تبين مسار الماء.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "وحيد الخلية يحصل على حاجاته بـ:", "a": "الانتشار", "o": ["الانتشار", "الدم"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}