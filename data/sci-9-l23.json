e=\"animation-delay:1.61s\" cx=\"189\" cy=\"270\" r=\"4\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:1.84s\" cx=\"206\" cy=\"270\" r=\"5\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:0.07s\" cx=\"223\" cy=\"270\" r=\"3\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:0.30s\" cx=\"160\" cy=\"270\" r=\"4\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:0.53s\" cx=\"177\" cy=\"270\" r=\"5\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:0.76s\" cx=\"194\" cy=\"270\" r=\"3\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:0.99s\" cx=\"211\" cy=\"270\" r=\"4\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:1.22s\" cx=\"228\" cy=\"270\" r=\"5\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:1.45s\" cx=\"165\" cy=\"270\" r=\"3\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:1.68s\" cx=\"182\" cy=\"270\" r=\"4\" fill=\"#fff\" stroke=\"#4fc3f7\"/><circle class=\"bb\" style=\"animation-delay:1.91s\" cx=\"199\" cy=\"270\" r=\"5\" fill=\"#fff\" stroke=\"#4fc3f7\"/><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">تصاعد فقاعات الغاز علامة</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">على حدوث تفاعل كيميائي</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["خلط بعض المواد يسبب تفاعلاً كيميائياً ينتج مواد جديدة، ومن أمثلته:", "1) الخل (حمض) + بيكربونات الصوديوم (صودا الخبز) ← فوران وتصاعد غاز ثاني أكسيد الكربون. 2) الحمض + الفلز (كالخارصين أو المغنيسيوم) ← ملح + غاز الهيدروجين. 3) الحمض + القاعدة ← ملح + ماء (تفاعل التعادل)، ومنه استخدام أقراص مضادات الحموضة لعلاج حموضة المعدة. 4) صدأ الحديد: حديد + أكسجين + ماء ← أكسيد الحديد (الصدأ). 5) خلط محلولين يكوّن راسباً.", "ويمكن الكشف عن غاز ثاني أكسيد الكربون بماء الجير الذي يتعكّر، وعن الهيدروجين بعود ثقاب مشتعل يُحدث فرقعة.", "تنبيه: لا نخلط المنظفات المنزلية (كالكلور مع الأحماض) لأنها تُنتج غازات سامة."]}], "lead": "استمع إلى الدرس، وشاهد المشهد، ثم تدرّب."}, {"title": "طابق", "eyebrow": "الخطوة ٢ — طابق", "heading": "الخلط والناتج", "blocks": [{"type": "choice", "star": true, "items": [{"q": "خل + صودا الخبز:", "a": "ثاني أكسيد الكربون", "o": ["ثاني أكسيد الكربون", "الأكسجين"]}, {"q": "حمض + فلز:", "a": "ملح + هيدروجين", "o": ["ملح + هيدروجين", "ماء فقط"]}, {"q": "حمض + قاعدة:", "a": "ملح + ماء", "o": ["ملح + ماء", "هيدروجين"]}, {"q": "حديد + أكسجين + ماء:", "a": "صدأ", "o": ["صدأ", "ذهب"]}]}]}, {"title": "الكشف", "eyebrow": "الخطوة ٣ — الكشف", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "يتعكّر بثاني أكسيد الكربون:", "a": "ماء الجير", "o": ["ماء الجير", "الماء المقطر"]}, {"q": "يُحدث فرقعة مع عود مشتعل:", "a": "الهيدروجين", "o": ["الهيدروجين", "CO₂"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "التعادل", "meaning": "حمض + قاعدة ← ملح + ماء", "ex": ""}, {"must": 1, "term": "الصدأ", "meaning": "حديد + أكسجين + ماء", "ex": ""}, {"must": 1, "term": "الكشف", "meaning": "ماء الجير لـ CO₂، الفرقعة للهيدروجين", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "لا يجوز خلط المنظفات المنزلية.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "مضادات الحموضة تعمل بتفاعل:", "a": "التعادل", "o": ["التعادل", "الاحتراق"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}