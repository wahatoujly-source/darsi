s=\"pp\" style=\"animation-delay:3.00s\" x=\"96\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.25s\" x=\"129\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.50s\" x=\"162\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:3.75s\" x=\"195\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.00s\" x=\"228\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.25s\" x=\"261\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.50s\" x=\"294\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:4.75s\" x=\"327\" y=\"135\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.00s\" x=\"30\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.25s\" x=\"63\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.50s\" x=\"96\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:5.75s\" x=\"129\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.00s\" x=\"162\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.25s\" x=\"195\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.50s\" x=\"228\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:6.75s\" x=\"261\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.00s\" x=\"294\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.25s\" x=\"327\" y=\"190\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.50s\" x=\"30\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:7.75s\" x=\"63\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.00s\" x=\"96\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.25s\" x=\"129\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.50s\" x=\"162\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:8.75s\" x=\"195\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.00s\" x=\"228\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.25s\" x=\"261\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.50s\" x=\"294\" y=\"245\" font-size=\"24\">🧍</text><text class=\"pp\" style=\"animation-delay:9.75s\" x=\"327\" y=\"245\" font-size=\"24\">🧍</text><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">يتركّز السكان حيث الماء والتربة</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الخصبة والمناخ المعتدل</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["آسيا أكثر القارات سكاناً، يعيش فيها نحو 60% من سكان العالم (أكثر من 4.7 مليار نسمة). وفيها أكبر دولتين سكاناً في العالم: الهند والصين، يزيد سكان كل منهما على مليار وأربعمائة مليون.", {"h": "التوزيع"}, "يتركز السكان في السهول الفيضية الخصبة: سهل الصين العظيم، وسهل الجانج، وجزيرة جاوة في إندونيسيا، واليابان. ويقلّون في سيبيريا الباردة، والصحاري، والهضاب والجبال العالية كالتبت.", {"h": "العوامل"}, "خصوبة التربة ووفرة المياه والأمطار الموسمية التي تناسب زراعة الأرز، والمناخ المعتدل، وفرص العمل في المدن.", {"h": "السلالات والديانات"}, "تتنوع سلالاتها: الجنس الأصفر (المغولي) في الشرق، والقوقازي في الغرب والجنوب، وغيرهما. وهي مهبط الإسلام والمسيحية واليهودية، وتنتشر فيها البوذية والهندوسية. ومن أكبر الدول الإسلامية سكاناً إندونيسيا وباكستان.", {"h": "مشكلات"}, "الازدحام في المدن الكبرى، وضغط السكان على الموارد، والفقر في بعض المناطق."]}], "lead": "استمع إلى الدرس، وتابع الخريطة في كتابك."}, {"title": "أين؟", "eyebrow": "الخطوة ٢ — أين؟", "heading": "يتركز أم يقل؟", "blocks": [{"type": "choice", "star": true, "items": [{"q": "سهل الصين العظيم:", "a": "يتركز", "o": ["يتركز", "يقل"]}, {"q": "سيبيريا:", "a": "يقل", "o": ["يتركز", "يقل"]}, {"q": "هضبة التبت:", "a": "يقل", "o": ["يتركز", "يقل"]}, {"q": "جزيرة جاوة:", "a": "يتركز", "o": ["يتركز", "يقل"]}]}]}, {"title": "اختر", "eyebrow": "الخطوة ٣ — اختر", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "أكبر دولتين سكاناً:", "a": "الهند والصين", "o": ["الهند والصين", "روسيا واليابان"]}, {"q": "نسبة سكان آسيا من العالم تقريباً:", "a": "60%", "o": ["60%", "10%"]}, {"q": "من أكبر الدول الإسلامية سكاناً:", "a": "إندونيسيا", "o": ["إندونيسيا", "منغوليا"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٤ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "آسيا", "meaning": "نحو 60% من سكان العالم", "ex": ""}, {"must": 1, "term": "الهند والصين", "meaning": "أكثر دول العالم سكاناً", "ex": ""}, {"must": 1, "term": "التركز", "meaning": "السهول الفيضية الخصبة", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٥ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "يقل السكان في الصحاري والجبال العالية.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "الأمطار الموسمية تناسب زراعة:", "a": "الأرز", "o": ["الأرز", "القمح فقط"], "ar": true, "why": ""}, {"q": "مهبط الإسلام:", "a": "آسيا", "o": ["آسيا", "أوروبا"], "ar": true, "why": ""}]}], "lead": "3 أسئلة. تنجح بـ 2 من 3."}]}