      {
       "q": "قسّم 60 ديناراً بنسبة 2 : 3",
       "steps": [
        "عدد الأجزاء: 2 + 3 = 5",
        "قيمة الجزء: 60 ÷ 5 = 12",
        "الأول: 2 × 12 = 24 ديناراً",
        "الثاني: 3 × 12 = 36 ديناراً"
       ]
      },
      {
       "q": "اكتب نسبة 45 دقيقة إلى ساعة ونصف في أبسط صورة.",
       "steps": [
        "ساعة ونصف = 90 دقيقة",
        "45 : 90 = 1 : 2"
       ]
