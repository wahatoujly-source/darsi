:", "a": "يزيد", "o": ["يزيد", "يقل"]}, {"q": "ارتفاع الرطوبة الجوية:", "a": "يقل", "o": ["يزيد", "يقل"]}, {"q": "هبوب الرياح:", "a": "يزيد", "o": ["يزيد", "يقل"]}, {"q": "طبقة شمعية سميكة:", "a": "يقل", "o": ["يزيد", "يقل"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "النتح", "meaning": "فقد بخار الماء من الأوراق عبر الثغور", "ex": ""}, {"must": 1, "term": "أهميته", "meaning": "سحب الماء وتبريد النبات", "ex": ""}, {"must": 1, "term": "البوتوميتر", "meaning": "جهاز لقياس النتح", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "الصبار متكيف لتقليل النتح.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "يخرج بخار الماء من الورقة عبر:", "a": "الثغور", "o": ["الثغور", "العروق"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}