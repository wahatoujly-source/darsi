     "examples": [
      {
       "q": "ثمن 3 أقلام 6 دنانير، فما ثمن 7 أقلام؟",
       "steps": [
        "كميتان متناسبتان طردياً.",
        "ثمن القلم الواحد: 6 ÷ 3 = 2 دينار",
        "ثمن 7 أقلام: 7 × 2 = 14 ديناراً"
       ]
      },
      {
       "q": "تقطع سيارة 240 كم بـ 20 لتراً، فكم تقطع بـ 35 لتراً؟",
       "steps": [
        "لكل لتر: 240 ÷ 20 = 12 كم",
        "35 × 12 = 420 كم"
       ]
      }
