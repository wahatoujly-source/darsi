 "dialogue": [
  [
   "Hamza",
   "Hi, I'm Hamza. In my spare time, I like finding out about other countries. I collect stamps and flags from all over the world."
  ],
  [
   "Yousef",
   "I'm Yousef. One day, I want to go to Kenya and take photos of the animals. For now, I cut out pictures from magazines."
  ],
  [
   "Laila",
   "My name is Laila. I'm interested in birds. I take photos of them, and then I find out their names."
  ],
  [
   "Tariq",
   "I'm Tariq. I want to be a pilot. I'm very interested in planes and flying, so you can guess what I collect!"
  ],
  [
   "Nour",
   "I'm Nour. I play football, I watch it on TV and I go to matches. So you know whose pictures I collect."
  ],
  [
   "Hana",
   "I'm Hana. I enjoy collecting pictures of plants and flowers. I love their colours and shapes."
  ]
