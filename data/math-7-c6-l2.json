     "paragraphs": [
      "لإيجاد قيمة مقدار جبري: نعوّض عن كل متغير بقيمته، ثم نحسب مع مراعاة ترتيب العمليات.",
      "مثال: إذا كانت س = 4: 3س + 5 = 3 × 4 + 5 = 17.",
      "مثال: إذا كانت أ = 2، ب = 5: أ² + 2ب = 4 + 10 = 14.",
      "انتبه للأعداد السالبة: إذا كانت س = −3: 2س + 1 = −6 + 1 = −5، و س² = (−3)² = 9."
     ]
    }
   ],
