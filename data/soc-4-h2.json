     "lang": "ar",
     "paragraphs": [
      {
       "h": "صيد الحيوانات"
      },
      "بعد أن استقرت الجماعات البشرية، بدأ الإنسان يعتمد على صيد الحيوانات والاستفادة من لحومها وجلودها في غذائه وكسائه.",
      "واستخدم طرقاً لصيدها كرميها بالحجارة أو إيقاعها في الحفر المخفية (الفخاخ)، ثم صنع القوس والسهم الخشبي والحجري.",
      {
       "h": "استئناس الحيوانات"
      },
      "استأنس الإنسان القديم الحيوانات الأليفة كالضأن والمعز والبقر، فاستفاد من لحومها في غذائه ومن جلودها ملبساً ومسكناً، واستفاد من الكلب في الحماية والحراسة.",
      {
       "h": "الزراعة"
      },
      "عرف الإنسان الزراعة بمشاهدته للبذور المتساقطة التي تنمو عقب سقوط الأمطار، فأخذ يجمعها ويزرعها حول مسكنه، ثم صنع المحراث الخشبي الذي تجره الحيوانات.",
      {
       "h": "الصناعة"
      },
      "صنع الإنسان القديم أسلحة الصيد من الخشب والحجارة، ووسائل حرث الأرض، وأدوات وأواني نقل الماء وطهو الطعام، معتمداً على الطين والأخشاب والأحجار.",
      "العصر الحجري: فترة ما قبل التاريخ، استعمل فيها الإنسان الحجارة لصنع الأدوات."
     ]
    }
   ],
   "lead": "استمع إلى الدرس. كتابك ص 13–17."
