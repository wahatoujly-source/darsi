,10 q5,25 -20,30 q-25,0 -45,-45z\" fill=\"#66bb6a\"/><path class=\"ry\" style=\"animation-delay:0.0s\" d=\"M110,105 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:0.5s\" d=\"M110,117 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:1.0s\" d=\"M110,129 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><path class=\"ry\" style=\"animation-delay:1.5s\" d=\"M110,141 q40,-12 80,0 t80,0\" stroke=\"#ff8f00\" stroke-width=\"3\" fill=\"none\"/><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#fff\">تصلنا حرارة الشمس</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#fff\">بالإشعاع عبر الفضاء</text></svg></div>"}, {"type": "panel", "anim": "libya_oil", "title": "🎬 شاهد", "html": "<div class=\"anim\" style=\"max-width:460px;margin:0 auto\"><svg viewBox=\"0 0 380 360\" role=\"img\" aria-label=\"النفط يُضخ من الحقول عبر الأنابيب إلى موانئ التصدير\" style=\"width:100%;height:auto;display:block;border-radius:16px;background:#dff1fb\" xmlns=\"http://www.w3.org/2000/svg\"><style>.pp{animation:pp 1.2s linear infinite}@keyframes pp{to{stroke-dashoffset:-26}}.pm{animation:pm 1.6s ease-in-out infinite}@keyframes pm{0%,100%{transform:rotate(-15deg)}50%{transform:rotate(15deg)}}@media (prefers-reduced-motion:reduce){*{animation:none!important}}</style><rect x=\"0\" y=\"0\" width=\"380\" height=\"70\" fill=\"#7cc4ea\"/><text x=\"300\" y=\"30\" font-size=\"13\" fill=\"#0d4f78\" text-anchor=\"middle\">البحر المتوسط</text><path d=\"M70,58 L104,62 L142,72 L172,96 L200,110 L232,112 L242,92 L242,78 L274,62 L292,64 L320,78 L342,88 L336,120 L340,280 L340,320 L320,320 L320,330 L158,252 L124,268 L110,256 L78,250 L70,234 L44,224 L28,196 L38,176 L34,158 L38,114 L46,102 L40,92 L58,78 Z\" fill=\"#f3d9a4\" stroke=\"#b07a2a\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><circle cx=\"104\" cy=\"62\" r=\"4\" fill=\"#c0392b\"/><text x=\"104\" y=\"78\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">طرابلس</text><circle cx=\"242\" cy=\"78\" r=\"4\" fill=\"#c0392b\"/><text x=\"242\" y=\"94\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">بنغازي</text><circle cx=\"128\" cy=\"180\" r=\"4\" fill=\"#c0392b\"/><text x=\"128\" y=\"196\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">سبها</text><circle cx=\"306\" cy=\"236\" r=\"4\" fill=\"#c0392b\"/><text x=\"306\" y=\"252\" font-size=\"11\" text-anchor=\"middle\" fill=\"#5a3b12\">الكفرة</text><path d=\"M220,164 L212,112\" stroke=\"#333\" stroke-width=\"2.5\" stroke-dasharray=\"8 5\" class=\"pp\"/><g transform=\"translate(210,138)\"><path d=\"M10,0 L2,26 M10,0 L18,26 M4,18 L16,18\" stroke=\"#37474f\" stroke-width=\"2\" fill=\"none\"/><rect class=\"pm\" x=\"-2\" y=\"2\" width=\"24\" height=\"5\" fill=\"#ef6c00\" style=\"transform-origin:10px 4px\"/></g><circle cx=\"212\" cy=\"112\" r=\"4\" fill=\"#212121\"/><path d=\"M252,152 L232,112\" stroke=\"#333\" stroke-width=\"2.5\" stroke-dasharray=\"8 5\" class=\"pp\"/><g transform=\"translate(242,126)\"><path d=\"M10,0 L2,26 M10,0 L18,26 M4,18 L16,18\" stroke=\"#37474f\" stroke-width=\"2\" fill=\"none\"/><rect class=\"pm\" x=\"-2\" y=\"2\" width=\"24\" height=\"5\" fill=\"#ef6c00\" style=\"transform-origin:10px 4px\"/></g><circle cx=\"232\" cy=\"112\" r=\"4\" fill=\"#212121\"/><path d=\"M192,172 L242,88\" stroke=\"#333\" stroke-width=\"2.5\" stroke-dasharray=\"8 5\" class=\"pp\"/><g transform=\"translate(182,146)\"><path d=\"M10,0 L2,26 M10,0 L18,26 M4,18 L16,18\" stroke=\"#37474f\" stroke-width=\"2\" fill=\"none\"/><rect class=\"pm\" x=\"-2\" y=\"2\" width=\"24\" height=\"5\" fill=\"#ef6c00\" style=\"transform-origin:10px 4px\"/></g><circle cx=\"242\" cy=\"88\" r=\"4\" fill=\"#212121\"/><path d=\"M278,168 L150,74\" stroke=\"#333\" stroke-width=\"2.5\" stroke-dasharray=\"8 5\" class=\"pp\"/><g transform=\"translate(268,142)\"><path d=\"M10,0 L2,26 M10,0 L18,26 M4,18 L16,18\" stroke=\"#37474f\" stroke-width=\"2\" fill=\"none\"/><rect class=\"pm\" x=\"-2\" y=\"2\" width=\"24\" height=\"5\" fill=\"#ef6c00\" style=\"transform-origin:10px 4px\"/></g><circle cx=\"150\" cy=\"74\" r=\"4\" fill=\"#212121\"/><text x=\"236\" y=\"194\" font-size=\"13\" text-anchor=\"middle\" fill=\"#5a3b12\">حوض سرت النفطي</text><text x=\"190.0\" y=\"329\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">النفط يُضخ من الحقول عبر</text><text x=\"190.0\" y=\"348\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#183b56\">الأنابيب إلى موانئ التصدير</text></svg></div>"}, {"type": "reading", "star": true, "lang": "ar", "paragraphs": ["مصادر غير متجددة: تنفد مع الاستعمال ولا تتجدد إلا في ملايين السنين، مثل: النفط والغاز الطبيعي والفحم (الوقود الأحفوري تكوّن من بقايا كائنات قديمة). ومن عيوبها تلويث الهواء وزيادة الاحتباس الحراري.", "مصادر متجددة: لا تنفد، ونظيفة غالباً: 1) الطاقة الشمسية بالألواح الشمسية، وليبيا من أغنى دول العالم بأشعة الشمس. 2) طاقة الرياح بالتوربينات (المراوح العملاقة). 3) الطاقة المائية من السدود والأمواج. 4) طاقة الكتلة الحيوية (المخلفات النباتية والحيوانية). 5) الطاقة الحرارية الجوفية من باطن الأرض.", "ليبيا تعتمد اليوم على النفط والغاز في الاقتصاد وإنتاج الكهرباء، والتوجه للطاقة الشمسية والرياح مهم للمستقبل.", "ترشيد استهلاك الطاقة: يحافظ على المصادر ويقلل التلوث."]}], "lead": "اقرأ واستمع، ثم أجب عن الأسئلة."}, {"title": "متجدد أم غير متجدد؟", "eyebrow": "الخطوة ٢ — متجدد أم غير متجدد؟", "heading": "", "blocks": [{"type": "choice", "star": true, "items": [{"q": "النفط", "a": "غير متجدد", "o": ["متجدد", "غير متجدد"]}, {"q": "الشمس", "a": "متجدد", "o": ["متجدد", "غير متجدد"]}, {"q": "الرياح", "a": "متجدد", "o": ["متجدد", "غير متجدد"]}, {"q": "الغاز الطبيعي", "a": "غير متجدد", "o": ["متجدد", "غير متجدد"]}, {"q": "الفحم", "a": "غير متجدد", "o": ["متجدد", "غير متجدد"]}]}]}, {"title": "احفظ", "eyebrow": "الخطوة ٣ — احفظ", "heading": "ما يجب أن تحفظه", "blocks": [{"type": "keywords", "star": true, "lang": "ar", "intro": "<b>انتبه جيداً!</b> هذه أهم المصطلحات والأفكار في الدرس، وستُسأل عنها في الامتحان. <b>احفظها وافهمها</b>، والبطاقات ذات الإطار الأصفر <b>ضرورية جداً</b>.", "items": [{"must": 1, "term": "غير المتجددة", "meaning": "تنفد: نفط، غاز، فحم", "ex": ""}, {"must": 1, "term": "المتجددة", "meaning": "لا تنفد: شمس، رياح، ماء", "ex": ""}, {"must": 1, "term": "ليبيا", "meaning": "غنية بالشمس", "ex": ""}]}]}, {"title": "اختبار", "eyebrow": "الخطوة ٤ — اختبار", "heading": "اختبر نفسك", "blocks": [{"type": "quiz", "star": true, "pass": 2, "items": [{"q": "الوقود الأحفوري يلوث الهواء.", "a": "صح", "o": ["صح", "خطأ"], "ar": true, "why": ""}, {"q": "تحوّل الرياح إلى كهرباء:", "a": "التوربينات", "o": ["التوربينات", "الألواح الشمسية"], "ar": true, "why": ""}]}], "lead": "2 أسئلة. تنجح بـ 2 من 2."}]}