     "examples": [
      {
       "q": "حوّل 9/20 إلى عدد عشري",
       "steps": [
        "20 × 5 = 100",
        "9 × 5 = 45",
        "9/20 = 45/100 = 0.45"
       ]
      },
      {
       "q": "حوّل 5/8 إلى عدد عشري",
       "steps": [
        "5 ÷ 8",
        "= 0.625"
